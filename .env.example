SUB2API_BASE_URL=https://your-sub2api-host:port
SUB2API_KEY=sk-your-key-here
SUB2API_MODEL=gemini-3.5-flash-low

# Tavily 搜索 API (检索型: 给 query 返 URL 列表, 无 LLM 参与).
# 免费额度 1000 credits/月, tvly-dev-* 是 dev key.
TAVILY_API_KEY=tvly-dev-your-key-here

# Grok (agentic search): 自己搜几十个页面读完再由 LLM 给答案.
# 与 Tavily 是两种东西 -- 详见 docs/superpowers/specs/2026-07-26-grok-search-engine-design.md
GROK_BASE_URL=https://your-grok2api-host
GROK_API_KEY=g2a_your-key-here
GROK_MODEL=grok-chat-fast
